# Environment Configuration for AgriForecasting
# Copy this file to .env before starting the services

# PostgreSQL Configuration
POSTGRES_DB=agriforecasting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Model Service Configuration
MODEL_SERVICE_PORT=8000
MODEL_PATH=/app/model/price_lgbm_full_features.pkl

# Java Backend Configuration
JAVA_BACKEND_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/agriforecasting
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
MODEL_SERVICE_URL=http://python-inference:8000

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=/api/v1

# Reverse Proxy Port
HTTP_PORT=80
